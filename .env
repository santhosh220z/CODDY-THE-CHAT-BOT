# JWT & Authentication
SECRET_KEY=super-secret-key-change-in-production-123456
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database Configuration
DATABASE_URL=sqlite:///./coddy.db

# Vector Database Configuration
VECTOR_STORE_TYPE=chroma
CHROMA_DB_PATH=./vector_store/chroma
FAISS_DB_PATH=./vector_store/faiss

# Document Chunking Configuration
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Embedding System Configuration
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Retrieval Configuration
RAG_TOP_K=5
HYBRID_SEARCH=true
BM25_WEIGHT=0.3

# LLM Service Configuration
LLM_PROVIDER=ollama

# Ollama Settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-r1:1.5b

# Hugging Face Settings (If LLM_PROVIDER=huggingface)
HF_API_KEY=
HF_MODEL=meta-llama/Meta-Llama-3-8B-Instruct

# General Directories
UPLOAD_DIR=./uploads
LOG_LEVEL=INFO
PORT=8000
HOST=0.0.0.0

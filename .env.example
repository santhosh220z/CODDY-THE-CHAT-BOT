# ===========================================================================
# CODDY - local RAG chatbot. Copy to .env and edit.
# ===========================================================================

# --- Security (REQUIRED) --------------------------------------------------
# Must be >= 32 chars and must NOT be the example value; the app refuses to
# start otherwise. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_python_-c_import_secrets_print_token_urlsafe_48
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
MIN_PASSWORD_LENGTH=8

# --- Database -------------------------------------------------------------
DATABASE_URL=sqlite:///./coddy.db

# --- Vector store ---------------------------------------------------------
# chroma | faiss
VECTOR_STORE_TYPE=chroma
CHROMA_DB_PATH=./vector_store/chroma
FAISS_DB_PATH=./vector_store/faiss

# --- Chunking -------------------------------------------------------------
# CHUNK_OVERLAP must be smaller than CHUNK_SIZE.
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# --- Embeddings -----------------------------------------------------------
# Must agree with whatever the index was built with. Changing it means
# re-uploading documents.
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
# Blank = let torch pick (cuda if available). Set to "cpu" to keep VRAM free
# entirely for the language model.
EMBEDDING_DEVICE=

# --- Retrieval ------------------------------------------------------------
RAG_TOP_K=5
HYBRID_SEARCH=true
# 0.0 = pure vector, 1.0 = pure BM25.
BM25_WEIGHT=0.4

# --- Local model ----------------------------------------------------------
# transformers | ollama
LLM_PROVIDER=transformers

# 4-bit quantization is mandatory on a 6GB card; bf16 is ~8GB and will OOM.
#   4B @ 4-bit ~= 2.6GB weights, leaving room for KV cache.
#   8B @ 4-bit ~= 5.2GB and will spill to system RAM - expect heavy slowdown.
LOAD_IN_4BIT=true
BNB_4BIT_COMPUTE_DTYPE=bfloat16
BNB_4BIT_QUANT_TYPE=nf4
MAX_NEW_TOKENS=1024
MODEL_TEMPERATURE=0.3
MODEL_TOP_P=0.9
# Truncate older history if the prompt would exceed this. Keeps VRAM stable
# during long conversations.
MODEL_MAX_CONTEXT=8192

# Text-only. For image/screenshot/scan support switch to a Qwen3-VL model,
# e.g. HF_MODEL_ID=Qwen/Qwen3-VL-4B-Instruct (costs ~500MB extra VRAM).
HF_MODEL_ID=Qwen/Qwen3-4B-Instruct-2507

# Used only when LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b

# --- Uploads --------------------------------------------------------------
MAX_UPLOAD_BYTES=15728640
UPLOAD_DIR=./uploads

# --- Server ---------------------------------------------------------------
# 127.0.0.1 keeps the app off the network. Use 0.0.0.0 only if you intend
# to expose it.
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
# Comma-separated origins. Empty = same-origin only (default).
CORS_ORIGINS=
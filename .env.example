# JWT & Authentication
SECRET_KEY=super-secret-key-change-in-production-123456
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database Configuration
# Use SQLite locally: sqlite:///./coddy.db
# Use PostgreSQL in production: postgresql://user:password@localhost:5432/coddy
DATABASE_URL=sqlite:///./coddy.db

# Vector Database Configuration
# Switch between: chroma | faiss
VECTOR_STORE_TYPE=chroma
CHROMA_DB_PATH=./vector_store/chroma
FAISS_DB_PATH=./vector_store/faiss

# Document Chunking Configuration
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Embedding System Configuration
# Supported out of the box:
# - sentence-transformers/all-MiniLM-L6-v2
# - BAAI/bge-large-en-v1.5
# - intfloat/e5-large-v2
# - Instructor XL (requires instructor package)
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Retrieval Configuration
RAG_TOP_K=5
HYBRID_SEARCH=true
BM25_WEIGHT=0.3

# LLM Service Configuration
# Switch between: ollama | huggingface
LLM_PROVIDER=ollama

# Ollama Settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-r1:1.5b

# Hugging Face Settings (If LLM_PROVIDER=huggingface)
# Can use HF API Token or load local transformer models
HF_API_KEY=
HF_MODEL=meta-llama/Meta-Llama-3-8B-Instruct

# General Directories
UPLOAD_DIR=./uploads
LOG_LEVEL=INFO
PORT=8000
HOST=0.0.0.0
